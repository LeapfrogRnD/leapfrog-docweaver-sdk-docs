BACKEND_API_URL=http://localhost:8001
DEFAULT_PORT=8000
X_API_KEY=ASDF
# Optional MCP auth settings. When enabled, unauthorized requests receive:
# 401 + WWW-Authenticate: Bearer realm="mcp", resource_metadata="..."
MCP_AUTH_ENABLED=false
MCP_RESOURCE_SERVER_BASE_URL=http://localhost:8000
MCP_AUTHORIZATION_SERVER_URL=https://auth.example.com
MCP_REQUIRED_SCOPES=mcp:read,mcp:write

# --- Mode 1: Static token (dev/testing only, single hardcoded token) ---
MCP_AUTH_MODE=static
MCP_ACCESS_TOKEN=replace-with-a-dev-token
MCP_CLIENT_ID=docweaver-mcp-client

# --- Mode 2: JWT (production, accepts tokens from any app via your backend) ---
# MCP_AUTH_MODE=jwt
# MCP_JWT_JWKS_URI=http://localhost:8001/auth/jwks        # preferred: auto key rotation
# MCP_JWT_PUBLIC_KEY=                                     # alternative: paste PEM public key
# MCP_JWT_ISSUER=http://localhost:8001                    # must match iss claim in token
# MCP_JWT_AUDIENCE=docweaver-mcp                         # must match aud claim in token
# MCP_JWT_ALGORITHM=RS256                                 # RS256 (asymmetric) or HS256 (symmetric)


BACKEND_API_URL=http://localhost:8001
FASTMCP_PORT=8000

MCP_AUTH_ENABLED=true
MCP_AUTH_MODE=jwt
MCP_AUTHORIZATION_SERVER_URL=http://127.0.0.1:8001
MCP_RESOURCE_SERVER_BASE_URL=http://127.0.0.1:8000
MCP_REQUIRED_SCOPES=openid,profile,email,mcp:read,mcp:write
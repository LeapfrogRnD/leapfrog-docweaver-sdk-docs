#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

check_command() {
  local name="$1"
  local workdir="$2"
  local timeout_seconds="$3"
  local logfile

  logfile="$(mktemp)"

  echo "[pre-commit] Checking ${name}..."
  pushd "$workdir" >/dev/null

  # Treat timeout as success because these commands are expected to start long-running services.
  if timeout "${timeout_seconds}s" uv run "$name" >"$logfile" 2>&1; then
    popd >/dev/null
    rm -f "$logfile"
    echo "[pre-commit] ${name} finished successfully."
    return 0
  fi

  local exit_code=$?
  popd >/dev/null

  if [[ "$exit_code" -eq 124 ]]; then
    rm -f "$logfile"
    echo "[pre-commit] ${name} started successfully (timed out intentionally after ${timeout_seconds}s)."
    return 0
  fi

  echo "[pre-commit] ${name} failed with exit code ${exit_code}."
  echo "[pre-commit] --- output (${name}) ---"
  cat "$logfile"
  echo "[pre-commit] --- end output ---"
  rm -f "$logfile"
  return "$exit_code"
}

check_command "server.py" "$REPO_ROOT" 20
check_command "main.py" "$REPO_ROOT/doc_processor" 20

echo "[pre-commit] All startup checks passed."

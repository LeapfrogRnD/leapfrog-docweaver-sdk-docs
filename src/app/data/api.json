{
  "baseUrl": "https://<your-domain>/api",
  "description": "OCR and document processing API. Contains workflow management, integrations (async)",
  "openapi_spec": {
    "openapi": "3.1.0",
    "info": {
      "title": "Leap DocWeaver API",
      "description": "document processing API",
      "version": "1.0.0"
    }
  },
  "endpoints": [
    {
      "id": "create-workflow",
      "title": "Create API Workflow",
      "icon": "Send",
      "subtitle": "Create a new workflow tied to the API key",
      "path": "/api/workflows/",
      "method": "POST",
      "description": "Create a new API workflow for the authenticated API key.",
      "params": [
        ["name", "string", "Name of the workflow"],
        ["workflow_type", "string", "Type of the workflow (extraction|classification|summarization)"],
        ["ocr_provider", "string", "OCR provider (aws_textract | azure_document_intelligence | vlm)"],
        ["parsing_method", "string", "Parsing method (layout_conserved|layout_conserved_advance)"],
        ["llm_model_provider", "string", "LLM provider (bedrock | openai)"],
        ["llm_model", "string", "LLM model name"],
        ["vlm_model_provider", "string", "VLM provider (bedrock) if OCR provider vlm is selected"],
        ["vlm_model", "string", "VLM model name"],
        ["x-api-key", "string", "API key header (X-API-Key)"],
        ["additional_instruction", "string", "Additional instructions for the workflow (optional)"],
        ["json_schema", "object", "JSON schema for structured output required for extraction and classification workflows"]
      ],
      "exampleRequest": "curl -X POST \"https://<your-domain>/api/workflows/\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"x-api-key: YOUR_API_KEY\" \\\n  -d '{ \"name\": \"invoice-parser\", \"workflow_type\": \"EXTRACTION\", \"ocr_provider\": \"aws_textract\", \"llm_model_provider\": \"openai\", \"llm_model\": \"gpt-4\" }'"
    },
    {
      "id": "list-workflows",
      "title": "List API Workflows",
      "icon": "ListChecks",
      "subtitle": "List workflows for the API key",
      "path": "/api/workflows/",
      "method": "GET",
      "description": "Get all API workflows for the authenticated API key.",
      "params": [
        ["page", "integer", "Page number (optional)"],
        ["page_size", "integer", "Items per page (optional)"],
        ["query", "string|null", "Filter query (optional)"],
        ["search", "string|null", "Search term (optional)"],
        ["status", "enum", "Filter by status: active | inactive | all"],
        ["x-api-key", "string", "API key header (X-API-Key)"]
      ],
      "exampleRequest": "curl -X GET \"https://<your-domain>/api/workflows/?page=1&page_size=25\" \\\n  -H \"x-api-key: YOUR_API_KEY\""
    },
    {
      "id": "get-workflow",
      "title": "Get API Workflow",
      "icon": "FileCode",
      "subtitle": "Retrieve workflow by ID",
      "path": "/api/workflows/{workflow_id}",
      "method": "GET",
      "description": "Get an API workflow by ID.",
      "params": [
        ["workflow_id", "integer", "Workflow ID (path)"],
        ["x-api-key", "string", "API key header (X-API-Key)"]
      ],
      "exampleRequest": "curl -X GET \"https://<your-domain>/api/workflows/123\" \\\n  -H \"x-api-key: YOUR_API_KEY\""
    },
    {
      "id": "update-workflow",
      "title": "Update API Workflow",
      "icon": "Zap",
      "subtitle": "Update an existing workflow",
      "path": "/api/workflows/{workflow_id}",
      "method": "PUT",
      "description": "Update an API workflow.",
      "params": [
        ["workflow_id", "integer", "Workflow ID (path)"],
        ["x-api-key", "string", "API key header (X-API-Key)"],
        ["body", "object", "ApiWorkFlowUpdateRequest body"]
      ],
      "exampleRequest": "curl -X PUT \"https://<your-domain>/api/workflows/123\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"x-api-key: YOUR_API_KEY\" \\\n  -d '{ \"name\": \"invoice-parser-v2\", \"workflow_type\": \"EXTRACTION\", \"ocr_provider\": \"aws_textract\", \"llm_model_provider\": \"openai\", \"llm_model\": \"gpt-4\" }'"
    },
    {
      "id": "delete-workflow",
      "title": "Delete API Workflow",
      "icon": "X",
      "subtitle": "Soft-delete a workflow",
      "path": "/api/workflows/{workflow_id}",
      "method": "DELETE",
      "description": "Soft delete an API workflow.",
      "params": [
        ["workflow_id", "integer", "Workflow ID (path)"],
        ["x-api-key", "string", "API key header (X-API-Key)"]
      ],
      "exampleRequest": "curl -X DELETE \"https://<your-domain>/api/workflows/123\" \\\n  -H \"x-api-key: YOUR_API_KEY\""
    },
    {
      "id": "integrate",
      "title": "Integrate (async)",
      "icon": "Send",
      "subtitle": "Create an asynchronous integration job",
      "path": "/api/integrations/",
      "method": "POST",
      "description": "Create an asynchronous integration job (typically referencing an S3 file).",
      "params": [
        ["workflow_name", "string", "Name of workflow to run (required)"],
        ["s3_file_uri", "string", "Optional S3 URI of input file"],
        ["file", "binary", "Optional binary file upload | file size limit 10MB | pdf page count limit 30 pages"],
        ["x-api-key", "string", "API key header (X-API-Key)"]
      ],
      "exampleRequest": "curl -X POST \"https://<your-domain>/api/integrations/\" \\\n  -H \"x-api-key: YOUR_API_KEY\" \\\n  -F \"workflow_name=invoice-parser\" -F \"file=@invoice.pdf\""
    },
    {
      "id": "poll-integration",
      "title": "Poll Integration Job",
      "icon": "Terminal",
      "subtitle": "Poll job status and results",
      "path": "/api/integrations/{integration_job_id}",
      "method": "GET",
      "description": "Use the integration_job_id returned by the create call to query status and results.",
      "params": [
        ["integration_job_id", "string", "Integration job id (path)"],
        ["x-api-key", "string", "API key header (X-API-Key)"]
      ],
      "exampleRequest": "curl -X GET \"https://<your-domain>/api/integrations/int_123\" \\\n  -H \"x-api-key: YOUR_API_KEY\""
    }
  ]
}